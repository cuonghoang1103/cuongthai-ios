      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi tạo nội dung"
          }
        }
      }
    },
    "While paused the agent can still read the project, but every change it tries is refused.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi tạm dừng, agent vẫn đọc được dự án nhưng mọi thay đổi nó thử làm đều bị từ chối."
          }
        }
      }
    },
    "Who": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ai"
          }
        }
      }
    },
