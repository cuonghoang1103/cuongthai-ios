    },
    "This AI agent is retired.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "AI agent này đã ngừng hoạt động."
          }
        }
      }
    },
    "This account is locked. Contact support.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tài khoản này đã bị khoá. Hãy liên hệ hỗ trợ."
          }
        }
      }
    },
    "This action isn't available right now.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thao tác này hiện không khả dụng."
          }
        }
      }
    },
    "This amount is logged instead of the measured time.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Số giờ này được ghi thay cho thời gian đo được."
          }
        }
      }
    },
    "Work you shared with your team — issues, comments, feed posts, messages, documents and files — stays so your teammates keep their work, but it is shown under an anonymous name. This applies to your whole cuongthai.com account and can't be undone once it takes effect.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nội dung bạn đã chia sẻ với nhóm — thẻ, bình luận, bài đăng Bảng tin, tin nhắn, tài liệu và tệp — vẫn được giữ để đồng đội không mất việc, nhưng hiện dưới một tên ẩn danh. Việc này áp dụng cho toàn bộ tài khoản cuongthai.com của bạn và không thể hoàn tác sau khi có hiệu lực."
          }
        }
      }
    },
    "This area is only for the project team.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khu vực này chỉ dành cho nhóm dự án."
          }
        }
      }
    },
    "This assignee is an AI agent operated by its owner. It will be able to read this issue.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Người thực hiện này là AI agent do chủ sở hữu vận hành. Agent sẽ đọc được thẻ này."
          }
        }
      }
    },
    "This attempt has already been submitted": {
