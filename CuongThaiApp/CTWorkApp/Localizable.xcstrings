        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn có thể chặn bất kỳ người dùng nào — bạn sẽ không còn thấy bình luận hay tin nhắn của họ."
          }
        }
      }
    },
    "You can delete your account at any time from Account › Delete account.": {
