<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Info.plist của app CT WORK riêng (com.cuongthai.ctwork) — KHÔNG dùng chung
  với app chính.

  Khai ĐÚNG HAI quyền: máy ảnh (chụp ảnh đính kèm vào thẻ / tin chat) và micro
  (ghi voice note gửi vào kênh chat — chỉ xin khi chạm nút micro lần đầu; trước lần
  ghi đầu app hỏi đồng ý việc máy chủ gửi âm thanh cho Groq để phiên âm, 5.1.2(i)).
  Họp video mở Meet/Zoom/Teams/Jitsi bằng hệ thống ⇒ app KHÔNG cần quyền camera/micro
  cho cuộc gọi, không VoIP/CallKit, không chế độ nền.
  · Chọn ảnh dùng `PhotosPicker` — chạy ngoài tiến trình, KHÔNG cần
    NSPhotoLibraryUsageDescription. Khai thừa = bị trả về (CLAUDE.md A14).
  · Chọn tệp dùng `fileImporter` — không cần quyền.
  · 1.1 (22/10/2026): NSPhotoLibraryAddUsageDescription — CHỈ THÊM ảnh vào thư viện khi người dùng chọn "Lưu ảnh" trên
    một tin nhắn (UIImageWriteToSavedPhotosAlbum — quyền "chỉ thêm", không đọc thư viện). Micro: thêm tin nhắn thoại
    trong tin nhắn riêng (KHÔNG phiên âm, không gửi bên thứ ba). Máy ảnh: thêm chụp ảnh đại diện.
  · Không vị trí, không nhận giọng nói trên máy: app này không dùng.
  · "Add to Calendar" dùng EventKitUI chạy ngoài tiến trình (iOS 17) ⇒ KHÔNG cần quyền Lịch.
  · Mảng D (18/10/2026): NSFaceIDUsageDescription — khoá app bằng Face ID (TUỲ CHỌN, mặc định tắt,
    Account → Security; `Modules/Account/KhoaAppCTW.swift`). NSSupportsLiveActivities — đồng hồ bấm giờ
    trên Màn hình khoá / Dynamic Island. CTWNhomKeychain — nhóm Keychain chia token cho Share Extension.
-->
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key><string>en</string>
    <key>CFBundleLocalizations</key>
    <array>
    	<string>en</string>
    	<string>vi</string>
    </array>
    <key>CFBundleDisplayName</key><string>CT Work</string>
    <key>CFBundleExecutable</key><string>$(EXECUTABLE_NAME)</string>
    <key>CFBundleIdentifier</key><string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleInfoDictionaryVersion</key><string>6.0</string>
    <key>CFBundleName</key><string>$(PRODUCT_NAME)</string>
    <key>CFBundlePackageType</key><string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
    <key>CFBundleShortVersionString</key><string>$(MARKETING_VERSION)</string>
    <key>CFBundleVersion</key><string>$(CURRENT_PROJECT_VERSION)</string>
    <key>LSRequiresIPhoneOS</key><true/>
    <key>ITSAppUsesNonExemptEncryption</key><false/>
    <key>UIApplicationSceneManifest</key>
    <dict>
        <key>UIApplicationSupportsMultipleScenes</key><false/>
    </dict>
    <!-- Màn khởi động: nền theo chế độ sáng/tối (không phải trắng loá). -->
    <key>UILaunchScreen</key>
    <dict>
        <key>UIColorName</key><string>NenKhoiDong</string>
    </dict>
    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>
    <!-- iPad: ĐỦ 4 hướng, thiếu là gói bị từ chối ở bước kiểm tự động. -->
    <key>UISupportedInterfaceOrientations~ipad</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationPortraitUpsideDown</string>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>
    <key>NSCameraUsageDescription</key><string>CT Work uses the camera only when you choose to take a photo — to attach it to an issue, a chat or direct message, a feed post, a Docs page or a test result, or to use it as your profile or cover photo.</string>
    <key>NSFaceIDUsageDescription</key><string>If you turn on Face ID lock in Account › Security, CT Work asks for Face ID when you open the app.</string>
    <key>NSSupportsLiveActivities</key><true/>
    <key>CTWNhomKeychain</key><string>$(AppIdentifierPrefix)com.cuongthai.ctwork.shared</string>
    <key>NSMicrophoneUsageDescription</key><string>CT Work uses the microphone only while you hold the microphone button to record a voice message for a team chat channel or a direct message.</string>
    <key>NSPhotoLibraryAddUsageDescription</key><string>CT Work adds a photo to your library only when you choose &quot;Save photo&quot; on a chat message.</string>
    <!-- Đăng nhập Google (build 7, 22/10/2026): client loại iOS RIÊNG của app này (project Google 20442169272, Bundle ID
         com.cuongthai.ctwork — tệp client_…plist tải từ Google Cloud). Máy chủ chấp nhận `aud` này (api-backend
         auth AUD_GOOGLE, 00a6c513). Scheme đảo ngược bên dưới nhận chuyển hướng của Google (`GIDSignIn.handle`). -->
    <key>GIDClientID</key><string>20442169272-u34g5m8cu3icggucjmmdmcb6cakc20u5.apps.googleusercontent.com</string>
    <!-- `ctwork://issue/KEY-12`, `ctwork://work/<ws>/<KEY>/issue/12` — app chính
         (và thông báo) mở thẳng một thẻ. Mục thứ hai: chuyển hướng của Google Sign-In. -->
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleURLName</key><string>com.cuongthai.ctwork</string>
            <key>CFBundleURLSchemes</key>
            <array><string>ctwork</string></array>
        </dict>
        <dict>
            <key>CFBundleURLName</key><string>com.cuongthai.ctwork.google</string>
            <key>CFBundleURLSchemes</key>
            <array><string>com.googleusercontent.apps.20442169272-u34g5m8cu3icggucjmmdmcb6cakc20u5</string></array>
        </dict>
    </array>
</dict>
</plist>
