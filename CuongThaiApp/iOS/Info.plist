<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key><string>$(DEVELOPMENT_LANGUAGE)</string>
    <key>CFBundleDisplayName</key><string>CuongThai</string>
    <key>CFBundleExecutable</key><string>$(EXECUTABLE_NAME)</string>
    <key>CFBundleIdentifier</key><string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleInfoDictionaryVersion</key><string>6.0</string>
    <key>CFBundleName</key><string>$(PRODUCT_NAME)</string>
    <key>CFBundlePackageType</key><string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
    <key>CFBundleShortVersionString</key><string>$(MARKETING_VERSION)</string>
    <key>CFBundleVersion</key><string>$(CURRENT_PROJECT_VERSION)</string>
    <key>LSRequiresIPhoneOS</key><true/>
    <key>ITSAppUsesNonExemptEncryption</key><false/>
    <!-- SwiftUI's App lifecycle installs its own scene delegate. The manifest
         used to name $(PRODUCT_MODULE_NAME).SceneDelegate, a class that does
         not exist in this target — UIKit logs a lookup failure for it at every
         launch. Declaring the manifest without a delegate class is correct here. -->
    <key>UIApplicationSceneManifest</key>
    <dict>
        <key>UIApplicationSupportsMultipleScenes</key><false/>
    </dict>
    <!-- Storyboard thay cho `UILaunchScreen` dict rỗng — dict rỗng chính là
         cái màn hình TRẮNG lúc mở app. `UILaunchScreen` + `UIImageName` cũng
         không dùng được: nó phóng ảnh cho đầy màn hình. -->
    <key>UILaunchStoryboardName</key><string>LaunchScreen</string>
    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>
    <key>NSCameraUsageDescription</key><string>CuongThai cần camera để bạn chụp ảnh hoặc quay video đăng lên bảng tin và đổi ảnh đại diện.</string>
    <key>NSMicrophoneUsageDescription</key><string>CuongThai cần micro để ghi âm thanh khi bạn quay video đăng lên bảng tin.</string>
    <key>NSPhotoLibraryUsageDescription</key><string>CuongThai cần thư viện ảnh để bạn chọn ảnh đính kèm vào bài viết và ảnh đại diện.</string>
    <!-- BẮT BUỘC: gọi requestWhenInUseAuthorization() mà thiếu khoá này thì iOS
         GIẾT app ngay, không phải hiện lỗi. Dùng cho nút "Vị trí" trong chat. -->
    <key>NSLocationWhenInUseUsageDescription</key><string>CuongThai cần vị trí để bạn chia sẻ chỗ mình đang đứng vào cuộc trò chuyện. Vị trí chỉ được gửi khi bạn tự bấm nút, và app không theo dõi bạn trong nền.</string>
    <!-- ── Đăng nhập Google — ĐÃ BẬT 19/08/2026 ─────────────────────────
         Client loại **iOS** (project 650641212127 "Cuong Thai Portfolio",
         Bundle ID com.cuongthai.app). KHÔNG có secret — đúng thiết kế: app
         cài trên máy người dùng thì ai cũng mở .ipa ra đọc được, nên Google
         cấm app di động giữ secret và ràng danh tính bằng Bundle ID + URL
         scheme riêng thay thế.

         ⚠️ Client loại **Web** của trang web KHÔNG dùng lại được ở đây. Đã đo
         thật: gọi endpoint OAuth bằng client Web kèm redirect kiểu app trả về
         "Custom scheme URIs are not allowed for 'WEB' client type" (400).

         ⚠️ CFBundleURLSchemes dưới đây là CLIENT ID ĐẢO NGƯỢC, không phải
         client ID. Đảo sai thì Google mở được màn đăng nhập, người dùng chọn
         xong tài khoản, rồi app KHÔNG bao giờ nhận lại kết quả — hỏng câm.
    -->
    <key>GIDClientID</key><string>650641212127-07fqeii3rqbpduj1ko39sc83bautslrs.apps.googleusercontent.com</string>
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleURLSchemes</key>
            <array>
                <string>com.googleusercontent.apps.650641212127-07fqeii3rqbpduj1ko39sc83bautslrs</string>
            </array>
        </dict>
    </array>
</dict>
</plist>
