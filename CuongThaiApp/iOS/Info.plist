<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key><string>$(DEVELOPMENT_LANGUAGE)</string>
    <key>CFBundleDisplayName</key><string>CuongThai</string>
    <key>CFBundleExecutable</key><string>$(EXECUTABLE_NAME)</string>
    <key>CFBundleIdentifier</key><string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleInfoDictionaryVersion</key><string>6.0</string>
    <key>CFBundleName</key><string>$(PRODUCT_NAME)</string>
    <key>CFBundlePackageType</key><string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
    <key>CFBundleShortVersionString</key><string>$(MARKETING_VERSION)</string>
    <key>CFBundleVersion</key><string>$(CURRENT_PROJECT_VERSION)</string>
    <key>LSRequiresIPhoneOS</key><true/>
    <key>ITSAppUsesNonExemptEncryption</key><false/>
    <!-- SwiftUI's App lifecycle installs its own scene delegate. The manifest
         used to name $(PRODUCT_MODULE_NAME).SceneDelegate, a class that does
         not exist in this target — UIKit logs a lookup failure for it at every
         launch. Declaring the manifest without a delegate class is correct here. -->
    <key>UIApplicationSceneManifest</key>
    <dict>
        <key>UIApplicationSupportsMultipleScenes</key><false/>
    </dict>
    <key>UILaunchScreen</key><dict/>
    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>
    <key>NSCameraUsageDescription</key><string>CuongThai cần camera để bạn chụp ảnh hoặc quay video đăng lên bảng tin và đổi ảnh đại diện.</string>
    <key>NSMicrophoneUsageDescription</key><string>CuongThai cần micro để ghi âm thanh khi bạn quay video đăng lên bảng tin.</string>
    <key>NSPhotoLibraryUsageDescription</key><string>CuongThai cần thư viện ảnh để bạn chọn ảnh đính kèm vào bài viết và ảnh đại diện.</string>
    <!-- ── Đăng nhập Google ─────────────────────────────────────────────
         CHƯA BẬT. Client loại Web của trang web KHÔNG dùng lại được: Google
         cấm app di động giữ secret (ai cũng mở .ipa ra đọc), nên app phải có
         client loại iOS riêng — không secret, ràng danh tính bằng Bundle ID.

         Bật bằng 3 bước, không cần sửa một dòng mã nào:
           1. console.cloud.google.com → project 650641212127 → Credentials
              → Create credentials → OAuth client ID → iOS
              → Bundle ID: com.cuongthai.app
           2. Dán client ID vào <string> của GIDClientID ngay dưới
           3. Dán client ID ĐẢO NGƯỢC vào CFBundleURLSchemes:
              ID  123-abc.apps.googleusercontent.com
              →   com.googleusercontent.apps.123-abc
         Chưa dán thì nút Google tự ẩn — thà không có nút còn hơn nút báo lỗi.
    -->
    <key>GIDClientID</key><string>DAN-CLIENT-ID-IOS-VAO-DAY</string>
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleURLSchemes</key>
            <array>
                <string>DAN-CLIENT-ID-DAO-NGUOC-VAO-DAY</string>
            </array>
        </dict>
    </array>
</dict>
</plist>
