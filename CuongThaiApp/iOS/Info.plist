<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key><string>$(DEVELOPMENT_LANGUAGE)</string>
    <key>CFBundleDisplayName</key><string>CuongThai</string>
    <key>CFBundleExecutable</key><string>$(EXECUTABLE_NAME)</string>
    <key>CFBundleIdentifier</key><string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleInfoDictionaryVersion</key><string>6.0</string>
    <key>CFBundleName</key><string>$(PRODUCT_NAME)</string>
    <key>CFBundlePackageType</key><string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
    <key>CFBundleShortVersionString</key><string>$(MARKETING_VERSION)</string>
    <key>CFBundleVersion</key><string>$(CURRENT_PROJECT_VERSION)</string>
    <key>LSRequiresIPhoneOS</key><true/>
    <key>ITSAppUsesNonExemptEncryption</key><false/>
    <!-- SwiftUI's App lifecycle installs its own scene delegate. The manifest
         used to name $(PRODUCT_MODULE_NAME).SceneDelegate, a class that does
         not exist in this target — UIKit logs a lookup failure for it at every
         launch. Declaring the manifest without a delegate class is correct here. -->
    <key>UIApplicationSceneManifest</key>
    <dict>
        <!-- Bật 19/09/2026 để Stage Manager mở được cửa sổ thứ hai (Vở bên
             trái, bài giảng bên phải). Trước khi bật đã phải sửa mọi chỗ
             giả định "chỉ có một cửa sổ": PKToolPicker gắn theo
             `windows.first` (bảng công cụ câm ở cửa sổ đang vẽ) và phép đo
             bề ngang qua `connectedScenes.first` (đo nhầm cửa sổ kia). -->
        <key>UIApplicationSupportsMultipleScenes</key><true/>
    </dict>
    <!-- Storyboard thay cho `UILaunchScreen` dict rỗng — dict rỗng chính là
         cái màn hình TRẮNG lúc mở app. `UILaunchScreen` + `UIImageName` cũng
         không dùng được: nó phóng ảnh cho đầy màn hình. -->
    <key>UILaunchStoryboardName</key><string>LaunchScreen</string>
    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>
    <!-- ⚠️ BẮT BUỘC từ lúc `TARGETED_DEVICE_FAMILY` có "2". iPad phải khai ĐỦ
         BỐN hướng, kể cả lộn ngược — thiếu một hướng là gói bị từ chối ngay ở
         bước KIỂM TỰ ĐỘNG, trước khi có người nhìn (đã dính 20/08/2026). Lý
         do của Apple: iPad không có "chiều đúng", người dùng dựng máy vào bàn
         phím kiểu nào cũng được, và đa nhiệm (Split View / Stage Manager) chỉ
         chạy khi app xoay được mọi chiều.

         Khoá này KHÔNG áp cho iPhone: hậu tố `~ipad` khiến iOS chỉ đọc nó
         trên iPad, còn iPhone vẫn dùng khối ba hướng ở trên (không lộn ngược
         — trên điện thoại, chân sạc chổng lên trời là tư thế không ai muốn). -->
    <key>UISupportedInterfaceOrientations~ipad</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationPortraitUpsideDown</string>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>
    <key>NSCameraUsageDescription</key><string>CuongThai cần camera để bạn chụp ảnh hoặc quay video đăng lên bảng tin và đổi ảnh đại diện.</string>
    <!-- Nhận giọng nói CHẠY TRÊN MÁY cho phần luyện nói với AI. Không có
         khoá này thì `SFSpeechRecognizer` trả lỗi quyền và màn luyện nói
         câm hoàn toàn — app vẫn chạy, chỉ là không nghe được gì. -->
    <key>NSSpeechRecognitionUsageDescription</key><string>CuongThai chuyển lời bạn nói thành chữ để luyện hội thoại với gia sư AI. Việc này xử lý ngay trên máy.</string>
    <key>NSMicrophoneUsageDescription</key><string>CuongThai cần micro để bạn gọi thoại với bạn bè, ghi tin nhắn thoại, ghi âm khi quay video, và ghi câu trả lời khi luyện nói IELTS. Bản ghi luyện nói chỉ dùng để chấm và bị xoá ngay sau đó.</string>
    <!-- Cuộc gọi phải tiếp tục khi người dùng chuyển sang app khác hoặc khoá
         máy. Thiếu `audio` thì iOS treo tiến trình sau vài giây và cuộc gọi
         chết câm — người kia chỉ nghe im lặng.
         `voip` sẽ thêm ở chặng CallKit/PushKit, chưa cần bây giờ. -->
    <key>UIBackgroundModes</key>
    <array>
      <string>audio</string>
    </array>
    <key>NSPhotoLibraryUsageDescription</key><string>CuongThai cần thư viện ảnh để bạn chọn ảnh đính kèm vào bài viết và ảnh đại diện.</string>
    <!-- ⚠️ `NSPhotoLibraryUsageDescription` (ĐỌC) KHÔNG thay được khoá này.
         Ghi ảnh mà thiếu `AddUsageDescription` thì iOS giết tiến trình ngay
         tại lời gọi — không phải báo lỗi, mà là SẬP. Xưởng vẽ xuất PNG vào
         Ảnh nên bắt buộc phải có. -->
    <key>NSPhotoLibraryAddUsageDescription</key><string>CuongThai cần quyền này để lưu ảnh bản vẽ bạn xuất ra từ Xưởng vẽ vào thư viện Ảnh.</string>
    <!-- BẮT BUỘC: gọi requestWhenInUseAuthorization() mà thiếu khoá này thì iOS
         GIẾT app ngay, không phải hiện lỗi. Dùng cho nút "Vị trí" trong chat. -->
    <key>NSLocationWhenInUseUsageDescription</key><string>CuongThai cần vị trí để bạn chia sẻ chỗ mình đang đứng vào cuộc trò chuyện. Vị trí chỉ được gửi khi bạn tự bấm nút, và app không theo dõi bạn trong nền.</string>
    <!-- ── Đăng nhập Google — ĐÃ BẬT 19/08/2026 ─────────────────────────
         Client loại **iOS** (project 650641212127 "Cuong Thai Portfolio",
         Bundle ID com.cuongthai.app). KHÔNG có secret — đúng thiết kế: app
         cài trên máy người dùng thì ai cũng mở .ipa ra đọc được, nên Google
         cấm app di động giữ secret và ràng danh tính bằng Bundle ID + URL
         scheme riêng thay thế.

         ⚠️ Client loại **Web** của trang web KHÔNG dùng lại được ở đây. Đã đo
         thật: gọi endpoint OAuth bằng client Web kèm redirect kiểu app trả về
         "Custom scheme URIs are not allowed for 'WEB' client type" (400).

         ⚠️ CFBundleURLSchemes dưới đây là CLIENT ID ĐẢO NGƯỢC, không phải
         client ID. Đảo sai thì Google mở được màn đăng nhập, người dùng chọn
         xong tài khoản, rồi app KHÔNG bao giờ nhận lại kết quả — hỏng câm.
    -->
    <key>GIDClientID</key><string>650641212127-07fqeii3rqbpduj1ko39sc83bautslrs.apps.googleusercontent.com</string>
    <key>CFBundleURLTypes</key>
    <array>
		<dict>
			<!-- Lược đồ riêng của app, để WIDGET mở thẳng màn Tiền nong.
			     Thiếu khối này thì `widgetURL` không mở được gì và chạm vào
			     widget chỉ mở app ở màn cũ — trông như widget chết. -->
			<key>CFBundleURLName</key><string>com.cuongthai.app</string>
			<key>CFBundleURLSchemes</key>
			<array><string>cuongthai</string></array>
		</dict>
        <dict>
            <key>CFBundleURLSchemes</key>
            <array>
                <string>com.googleusercontent.apps.650641212127-07fqeii3rqbpduj1ko39sc83bautslrs</string>
            </array>
        </dict>
    </array>
	<!-- Cho thư mục Documents của app hiện trong Files › Trên iPad tôi.
	     Lý do: 18/09/2026 người dùng cần đưa 12 PDF giáo trình vào vở, mà
	     iCloud Drive của họ ĐẦY (`Quota exceeded`) nên đường mây tắc. Bật hai
	     khoá này thì kéo thả tệp thẳng từ máy tính qua cáp, và cũng là đường
	     lấy vở ra sao lưu khi cần. -->
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
</dict>
</plist>
